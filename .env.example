# Copy this file to .env before running Docker Compose.
# Keep .env local: it may contain deployment-specific credentials.

# Host ports published by docker-compose.yml.
GOPAD_HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Gopad container configuration.
GOPAD_ADDR=:8080
GOPAD_DB_PATH=/data/gopad.db
GOPAD_LOG_LEVEL=info
GOPAD_ROOM_IDLE_TIMEOUT=45s
GOPAD_WRITE_QUEUE_SIZE=1024
GOPAD_OP_BATCH_SIZE=100
GOPAD_OP_FLUSH_INTERVAL=250ms
GOPAD_SNAPSHOT_OP_THRESHOLD=1000
GOPAD_SNAPSHOT_INTERVAL=30s
GOPAD_ENABLE_PPROF=0

# Grafana credentials for local development only.
# Replace these before exposing Grafana outside localhost.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ALLOW_SIGN_UP=false
